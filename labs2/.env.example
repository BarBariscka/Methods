# Google ADK Agent Configuration

# LLM Configuration
LLM_MODEL=ollama/llama3.2
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=your-api-key-here

# Agent Configuration
AGENT_NAME=Work Agent
AGENT_DESCRIPTION=This agent do work
AGENT_VERSION=v1.0.0
AGENT_SYSTEM_PROMPT=You are a helpful AI assistant.

# A2A Configuration
URL_AGENT=http://localhost:10000
PORT=10000

# MCP Configuration (optional, comma-separated)
MCP_URL=http://localhost:8000/sse

# Telemetry Configuration
PHOENIX_ENDPOINT=https://your-phoenix-endpoint/v1/traces
ENABLE_PHOENIX=false

# Logging
LOG_LEVEL=INFO


