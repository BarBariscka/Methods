# Переменные окружения для docker-compose.local.yaml
# Скопируйте в .env и заполните нужные значения.

# --- LLM ---
# Локальный Ollama (по умолчанию):
#   Docker:  docker compose -f docker-compose.local.yaml up -d ollama
#            docker exec -it pis-ollama ollama pull llama3.2
#   Нативно: ollama serve && ollama pull llama3.2
#   Из контейнеров агентов Ollama виден как host.docker.internal:11434,
#   с хоста — localhost:11434. Ключ не нужен (dummy).
LLM_API_KEY=dummy
LLM_API_BASE=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2
# Для litellm/ADK (лаб. 2) модель указывается с префиксом провайдера: ollama/llama3.2
# Настройки Ollama (сервис в docker-compose.local.yaml):
#   OLLAMA_KEEP_ALIVE=10m, OLLAMA_NUM_PARALLEL=2, OLLAMA_MAX_LOADED_MODELS=1
# Облако cloud.ru (опционально, вместо Ollama):
# LLM_API_KEY=<ваш ключ>
# LLM_API_BASE=https://foundation-models.api.cloud.ru/v1
# LLM_MODEL=Qwen/Qwen3-Coder-480B-A35B-Instruct

# --- Lab 7: Mattermost-бот ---
MATTERMOST_URL=https://mattermost.example.com
MATTERMOST_TOKEN=
MATTERMOST_CHANNEL=pis

# --- Lab 8: Telegram-бот ---
TELEGRAM_BOT_TOKEN=

# --- A2A / observability ---
# Базовый URL A2A-агента (лаб. 2–6), к которому подключаются боты
A2A_BASE_URL=http://host.docker.internal:8002
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
